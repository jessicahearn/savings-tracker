# Copy to .env.prod on the mini-PC and fill in. .env.prod is gitignored and
# must never be committed — this repository is public.

# The no-ip hostname the app is served on. Keep the real value here only.
APP_HOSTNAME=your-host.ddns.net

# Postgres. DATABASE_URL is assembled from these in docker-compose.prod.yml,
# so the password is written in exactly one place.
POSTGRES_DB=savings_tracker
POSTGRES_USER=savings_tracker
POSTGRES_PASSWORD=

# Signs the session cookie. The server refuses to start in production without
# it, because the development fallback is published in this repository.
# Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=
