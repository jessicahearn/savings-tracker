# PostgreSQL
DATABASE_URL=postgres://savings_tracker:dev_password@localhost:5432/savings_tracker_dev

# Integration tests run against their own database, never the dev one.
# Create and migrate it with: npm run db:test:prepare -w server
TEST_DATABASE_URL=postgres://savings_tracker:dev_password@localhost:5432/savings_tracker_test

# Session
# Required when NODE_ENV=production — the server refuses to start without it.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=your-secret-key-here-make-it-random

# Server
PORT=4000
NODE_ENV=development
